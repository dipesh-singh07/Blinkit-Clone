<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
    <!-- Hero Banner -->
    <section class="hero-banner">
        <div class="container hero-content">
            <div class="hero-text">
                <h1>Everything delivered in <span>10 minutes</span></h1>
                <p>Order fresh milk, farm veggies, daily snacks, beverages and household essentials instant at low prices.</p>
                <div class="hero-badges">
                    <div class="hero-badge-item">⚡ 10 Min Delivery</div>
                    <div class="hero-badge-item">🥛 Best Prices</div>
                    <div class="hero-badge-item">🛡️ 100% Quality Assured</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories Section -->
    <section>
        <div class="section-header">
            <h2 class="section-title">Explore Categories</h2>
            <a href="/products" class="view-all-link">View All Categories →</a>
        </div>
        
        <div class="categories-grid">
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                    <a href="/products/category/<%= category._id %>" class="category-card">
                        <img 
                            src="<%= category.image || 'https://images.unsplash.com/photo-1542838132-92c53300491e?w=500&auto=format&fit=crop&q=60' %>" 
                            alt="<%= category.name %>" 
                            class="category-img"
                        >
                        <span class="category-name"><%= category.name %></span>
                    </a>
                <% }) %>
            <% } else { %>
                <p style="color: var(--text-muted);">No categories found. Run seeder script!</p>
            <% } %>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section>
        <div class="section-header">
            <h2 class="section-title">Trending Daily Essentials</h2>
            <a href="/products" class="view-all-link">Browse Full Catalog →</a>
        </div>

        <div class="products-grid">
            <% if (products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <span class="product-badge">10 MINS</span>
                        
                        <a href="/products/<%= product._id %>" class="product-image-wrap">
                            <img 
                                src="<%= product.image %>" 
                                alt="<%= product.name %>"
                                onerror="this.src='https://images.unsplash.com/photo-1542838132-92c53300491e?w=500&auto=format&fit=crop&q=60'"
                            >
                        </a>

                        <div class="product-brand"><%= product.brand || 'Blinkit Fresh' %></div>
                        
                        <a href="/products/<%= product._id %>" class="product-name">
                            <%= product.name %>
                        </a>
                        
                        <div class="product-unit"><%= product.unit %></div>

                        <div class="product-card-footer">
                            <div class="product-price">₹<%= product.price %></div>
                            <div 
                                class="product-cart-action" 
                                data-product-id="<%= product._id %>" 
                                data-stock="<%= product.quantity %>"
                                data-product-name="<%= product.name %>"
                                data-product-price="<%= product.price %>"
                                data-product-image="<%= product.image %>"
                                data-product-unit="<%= product.unit || '1 unit' %>"
                            >
                                <% if (product.isAvailable && product.quantity > 0) { %>
                                    <button class="btn-add" onclick="handleAddToCart('<%= product._id %>')">ADD</button>
                                <% } else { %>
                                    <span style="color: #ef4444; font-size: 0.8rem; font-weight: 700;">Out of Stock</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; grid-column: 1 / -1; padding: 2rem;">
                    <p>No products available yet. Run <code>npm run seed</code> to populate the store!</p>
                </div>
            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
